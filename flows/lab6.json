[
    {"id": "flow_tab_6", "type": "tab", "label": "Lab 6: TCP Sockets", "disabled": false, "info": ""},
    {"id": "ui_tab_6", "type": "ui_tab", "name": "Lab 6 Dashboard", "icon": "envelope", "order": 3, "disabled": false, "hidden": false},
    {"id": "ui_group_6", "type": "ui_group", "name": "TCP Socket Data (Lab 6)", "tab": "ui_tab_6", "order": 1, "width": "6", "disp": true, "collapse": false},
    {"id": "inject_6", "type": "inject", "z": "flow_tab_6", "name": "1s Tick", "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}], "repeat": "1", "crontab": "", "once": true, "onceDelay": 0.1, "topic": "", "payload": "", "payloadType": "date", "x": 110, "y": 140, "wires": [["tcp_temp_6", "tcp_hum_6"]]},
    {"id": "tcp_temp_6", "type": "tcp request", "z": "flow_tab_6", "name": "TCP Temp Port 9001", "server": "host.containers.internal", "port": "9001", "out": "time", "splitc": "0", "ret": "buffer", "newline": "", "trim": true, "tls": "", "x": 320, "y": 100, "wires": [["func_temp_parse_6"]]},
    {"id": "tcp_hum_6", "type": "tcp request", "z": "flow_tab_6", "name": "TCP Hum Port 9002", "server": "host.containers.internal", "port": "9002", "out": "time", "splitc": "0", "ret": "buffer", "newline": "", "trim": true, "tls": "", "x": 320, "y": 180, "wires": [["func_hum_parse_6"]]},
    {"id": "func_temp_parse_6", "type": "function", "z": "flow_tab_6", "name": "Temp Parse", "func": "msg.payload = parseFloat(msg.payload.toString());\nmsg.topic = \"temperature\";\nreturn msg;", "outputs": 1, "x": 510, "y": 100, "wires": [["ui_chart_temp_6", "join_6"]]},
    {"id": "func_hum_parse_6", "type": "function", "z": "flow_tab_6", "name": "Hum Parse", "func": "msg.payload = parseFloat(msg.payload.toString());\nmsg.topic = \"humidity\";\nreturn msg;", "outputs": 1, "x": 510, "y": 180, "wires": [["ui_chart_hum_6", "join_6"]]},
    {"id": "ui_chart_temp_6", "type": "ui_chart", "z": "flow_tab_6", "name": "Temp Chart", "group": "ui_group_6", "order": 1, "width": "6", "height": "4", "label": "Temperature (C)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "ymin": "19", "ymax": "45", "removeOlder": "1", "removeOlderPoints": "", "removeOlderUnit": "60", "colors": ["#1f77b4"], "outputs": 1, "x": 730, "y": 60, "wires": [[]]},
    {"id": "ui_chart_hum_6", "type": "ui_chart", "z": "flow_tab_6", "name": "Hum Chart", "group": "ui_group_6", "order": 2, "width": "6", "height": "4", "label": "Humidity (%)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "ymin": "49", "ymax": "75", "removeOlder": "1", "removeOlderPoints": "", "removeOlderUnit": "60", "colors": ["#aec7e8"], "outputs": 1, "x": 730, "y": 220, "wires": [[]]},
    {"id": "join_6", "type": "join", "z": "flow_tab_6", "name": "Join Temp/Hum", "mode": "custom", "build": "object", "property": "payload", "propertyType": "msg", "key": "topic", "timer": "", "count": 2, "continueDelay": false, "x": 710, "y": 140, "wires": [["func_control_6"]]},
    {"id": "func_control_6", "type": "function", "z": "flow_tab_6", "name": "Status Control", "func": "var temp = msg.payload.temperature;\nvar hum = msg.payload.humidity;\nvar status = context.get('status') || \"GOOD\";\n\nif (temp > 40.4 || hum > 70.4) {\n    status = \"BAD\";\n} else if (temp <= 34.4 && hum <= 64.4) {\n    status = \"GOOD\";\n}\n\ncontext.set('status', status);\n\nmsg.payload = status;\nmsg.background = (status === \"GOOD\") ? \"green\" : \"red\";\nreturn msg;", "outputs": 1, "x": 880, "y": 140, "wires": [["ui_button_status_6"]]},
    {"id": "ui_button_status_6", "type": "ui_button", "z": "flow_tab_6", "name": "Status Button", "group": "ui_group_6", "order": 3, "width": "6", "height": "1", "passthru": false, "label": "{{msg.payload}}", "tooltip": "", "color": "white", "bgcolor": "{{msg.background}}", "icon": "", "payload": "", "payloadType": "str", "topic": "topic", "topicType": "msg", "x": 1040, "y": 140, "wires": [[]]}
]
